# Academic Advisor & Degree Planning System - Environment Configuration
# Copy this file to .env for local development

# Django Core
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me-to-a-secure-random-string-in-production
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],academic.institution.edu

# Database (PostgreSQL 16)
DATABASE_URL=postgres://postgres:postgres_dev_password@localhost:5432/degree_planning_dev

# CORS and CSRF
CORS_ALLOWED_ORIGINS=https://academic.institution.edu,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://academic.institution.edu,http://localhost:5173

# Production Security Flags (All required in production)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# AI Assistant Multi-Tier Fallback Configuration
# Tier 1: Primary Free AI Provider (Google Gemini API via Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# Tier 2: Secondary Free AI Provider (Groq Free Cloud: https://console.groq.com/keys OR secondary Gemini/OpenRouter key)
SECONDARY_AI_API_KEY=
SECONDARY_AI_PROVIDER=groq

